{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Arduino: <daikin-controller> - Compile",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--libraries", "./shared",
                "--fqbn", "${config:myproject.fqbn}",
                "--build-path", "${workspaceFolder}/build/daikin-controller",
                
                //"--build-property", "\"compiler.cpp.extra_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "\"compiler.c.extra_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "\"build.extra_flags=\\\"-Wall -Wextra\\\"\"",
                //"--build-property", "\"compiler.cxx.extra_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "\"compiler.warning_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "build.extra_flags='${config:myproject.compiler.extra_flags}'",
                //"--build-property", "compiler.cxx.extra_flags='${config:myproject.compiler.extra_flags}'",
                //"--build-property", "compiler.warning_flags='${config:myproject.compiler.extra_flags}'",
                //"--build-property", "\"compiler.cpp.extra_flags=-Wno-unused-function\"",
                //"--build-property", "\"compiler.c.extra_flags=-Wno-unused-function\"",

                "--warnings", "${config:myproject.compiler.warnings}",
                "--build-property", "\"compiler.cpp.extra_flags=${config:myproject.compiler.extra_flags}\"",
                "--build-property", "\"compiler.c.extra_flags=${config:myproject.compiler.extra_flags}\"",

                "${workspaceFolder}/daikin-controller/."
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: <daikin-controller> - Upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "--fqbn", "${config:myproject.fqbn}",
                "--build-path", "${workspaceFolder}/build/daikin-controller",
                "--port", "${config:myproject.port}",
                "${workspaceFolder}/daikin-controller/."
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: <zigbee-bridge> - Compile",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--libraries", "./shared",
                "--fqbn", "${config:myproject.fqbn}",
                "--build-path", "${workspaceFolder}/build/zigbee-bridge",
                
                //"--build-property", "\"compiler.cpp.extra_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "\"compiler.c.extra_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "\"build.extra_flags=\\\"-Wall -Wextra\\\"\"",
                //"--build-property", "\"compiler.cxx.extra_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "\"compiler.warning_flags=\\\"${config:myproject.compiler.extra_flags}\\\"\"",
                //"--build-property", "build.extra_flags='${config:myproject.compiler.extra_flags}'",
                //"--build-property", "compiler.cxx.extra_flags='${config:myproject.compiler.extra_flags}'",
                //"--build-property", "compiler.warning_flags='${config:myproject.compiler.extra_flags}'",
                //"--build-property", "\"compiler.cpp.extra_flags=-Wno-unused-function\"",
                //"--build-property", "\"compiler.c.extra_flags=-Wno-unused-function\"",

                "--warnings", "${config:myproject.compiler.warnings}",
                "--build-property", "\"compiler.cpp.extra_flags=${config:myproject.compiler.extra_flags}\"",
                "--build-property", "\"compiler.c.extra_flags=${config:myproject.compiler.extra_flags}\"",

                "${workspaceFolder}/zigbee-bridge/."
            ],
            "group": {
                "kind": "build",
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: <zigbee-bridge> - Upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "--fqbn", "${config:myproject.fqbn}",
                "--build-path", "${workspaceFolder}/build/zigbee-bridge",
                "--port", "${config:myproject.port}",
                "${workspaceFolder}/zigbee-bridge/."
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: Compile <all>",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Arduino: <daikin-controller> - Compile",
                "Arduino: <zigbee-bridge> - Compile",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: <daikin-controller> - Compile & Upload",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Arduino: <daikin-controller> - Compile",
                "Arduino: <daikin-controller> - Upload"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Arduino: <zigbee-bridge> - Compile & Upload",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Arduino: <zigbee-bridge> - Compile",
                "Arduino: <zigbee-bridge> - Upload"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
